# AWS Credentials for AWS Pricing MCP Server
# Copy this file to .env.aws and fill in your credentials
# Then load it before starting docker-compose: Set-Variable -Name "env:AWS_*" -Value ...

# Required AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Optional - only needed for temporary/session credentials
AWS_SESSION_TOKEN=

# Optional - defaults to us-east-1
AWS_REGION=us-east-1

# Usage:
# 1. Copy this template: cp .env.aws.template .env.aws
# 2. Edit .env.aws with your actual credentials
# 3. Load before docker-compose: Get-Content .env.aws | ForEach-Object { if ($_ -match '^([^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process") } }
# 4. Start: docker-compose up -d aws-pricing-mcp
