# Environment Configuration Template
# Copy this to .env and fill in your actual values

# Service Authentication (Generate a secure random token)
SERVICE_AUTH_TOKEN=your-secure-service-token-here

# LLM API Keys (Add your actual API keys)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/migration_platform
PROJECT_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/project_service

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=migration-platform

# Vector Database (Weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=optional-api-key

# Embedding Model Configuration
# Options: all-MiniLM-L6-v2 (default), jinaai/jina-embeddings-v2-base-en
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Service URLs
BACKEND_URL=http://localhost:8000
PROJECT_SERVICE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/platform.log

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# ============================================================================
# Service Timeout Configuration (in seconds)
# ============================================================================
# These timeouts account for long-running LLM operations (up to 15 minutes)
# and complex document processing workflows

# HTTP Client Timeouts
HTTP_CLIENT_CONNECT_TIMEOUT=30
HTTP_CLIENT_READ_TIMEOUT=1000
HTTP_CLIENT_WRITE_TIMEOUT=300
HTTP_CLIENT_POOL_TIMEOUT=10

# LLM Service Timeouts
LLM_REQUEST_TIMEOUT=900           # 15 minutes for LLM responses
LLM_EXTRACTION_TIMEOUT=1000       # 16+ minutes for entity extraction

# Graph Service Timeouts
GRAPH_BASE_TIMEOUT_SECONDS=1000   # Base timeout for graph operations
GRAPH_LLM_CALL_TIMEOUT=1000       # Timeout for graph->LLM calls
GRAPH_BATCH_TIMEOUT=1200          # Timeout for batch processing

# Document Service Timeouts
DOCUMENT_GRAPH_TIMEOUT=1200       # Timeout for document->graph integration
DOCUMENT_VECTOR_TIMEOUT=600       # Timeout for document->vector integration
DOCUMENT_PROCESSING_TIMEOUT=1800  # Overall document processing timeout

# Service-to-Service Call Timeouts
SERVICE_CLIENT_DEFAULT_TIMEOUT=300
SERVICE_CLIENT_LONG_TIMEOUT=1200

# File Operation Timeouts
FILE_CLEANUP_RETRY_ATTEMPTS=5
FILE_CLEANUP_RETRY_DELAY=2        # seconds between retries
FILE_CLEANUP_MAX_DELAY=10         # max delay between retries
