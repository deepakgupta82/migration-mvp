# Document Conversion & OCR Strategies

direction: down

# Input Documents
input_documents: Input Documents {
  shape: hexagon
  style.fill: "#e1f5fe"
  label: "Input Documents\n• PDF (primary)\n• DOCX, XLSX, PPTX\n• TXT, MD, HTML\n• XML, JSON, CSV\n• Images (OCR)\n• ZIP archives"
}

# Primary Conversion Strategy
unstructured_primary: Unstructured.io Primary {
  shape: rectangle
  style.fill: "#4caf50"
  style.stroke: "#2e7d32"
  style.stroke-width: 3
  label: "Primary Strategy: Unstructured.io\nHigh-Resolution Partitioning\n\n• Advanced PDF layout analysis\n• Table extraction & structure\n• Reading order preservation\n• Multi-page table merging\n• Section paths & hierarchy\n• Element classification\n• Confidence scoring"
}

