# OCR Integration
ocr_integration: OCR Integration {
  shape: diamond
  style.fill: "#fff8e1"
  label: "OCR Required?\n• Scanned PDFs\n• Image-based content\n• Low text-to-image ratio\n• Primary processor failure"
}

tesseract_ocr: Tesseract OCR {
  shape: rectangle
  style.fill: "#9c27b0"
  style.stroke: "#6a1b9a"
  style.stroke-width: 2
  label: "Tesseract OCR Engine\n• Optical character recognition\n• Multi-language support\n• Image preprocessing\n• Text confidence scoring\n• Path: C:\\Program Files\\Tesseract-OCR"
}

# Output Formats
structured_jsonl: Structured JSONL Output {
  shape: document
  style.fill: "#e3f2fd"
  label: "Structured JSONL Output\n• Element-based format\n• Rich metadata\n• Element types:\n  - title, narrative_text\n  - list_item, table\n  - image, header, footer\n  - caption\n• Page numbers & coordinates\n• Reading order\n• Confidence scores"
}

# Processing Flow
input_documents -> unstructured_primary: "All document types"

unstructured_primary -> structured_jsonl: "Success" {
  style.stroke: "#4caf50"
  style.stroke-width: 3
}

unstructured_primary -> markitdown_fallback: "Failure" {
  style.stroke: "#ff9800"
  style.stroke-width: 2
}

markitdown_fallback -> structured_jsonl: "Success"
markitdown_fallback -> pymupdf_fallback: "Failure"

pymupdf_fallback -> structured_jsonl: "Success"
pymupdf_fallback -> pdfminer_fallback: "Failure"

pdfminer_fallback -> structured_jsonl: "Success"
pdfminer_fallback -> pdfplumber_fallback: "Failure"

pdfplumber_fallback -> structured_jsonl: "Success"
pdfplumber_fallback -> ocr_integration: "Failure"

# OCR Flow
ocr_integration -> tesseract_ocr: "OCR Required" {
  style.stroke: "#9c27b0"
  style.stroke-width: 2
}

tesseract_ocr -> structured_jsonl: "OCR Success"
tesseract_ocr -> error_handling: "OCR Failure"

