            related_docs = await self._find_related_documents(document)
            document.relationships = related_docs
            
            # Add to search index
            self._add_to_search_index(document)
            
            # Update status
            document.status = KnowledgeStatus.INDEXED
            document.updated_at = datetime.now()
            
