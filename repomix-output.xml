        return {
            "apache": {"aws": ["ec2"], "azure": ["azure_vm"], "gcp": ["gcp_compute_engine"]},
            "nginx": {"aws": ["ec2"], "azure": ["azure_vm"], "gcp": ["gcp_compute_engine"]},
