    background_tasks.add_task(
        analytics_manager.add_metric_data,
        request.metric_name,
        request.value,
        request.metadata
    )
    return {"message": "Metric data added successfully"}

@app.get("/metrics/real-time")
async def get_real_time_metrics(metric_names: str, limit: int = 100):
