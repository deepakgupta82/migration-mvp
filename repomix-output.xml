                    json={
                        "channel_type": "knowledge",
                        "message": {
                            "type": event_type,
                            "data": data,
                            "timestamp": datetime.now().isoformat()
                        }
                    }
                )
        except Exception as e:
            logger.warning(f"Failed to send WebSocket notification: {e}")
    
    def get_document(self, doc_id: str) -> Optional[KnowledgeDocument]:
