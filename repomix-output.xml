                        provider: str, 
                        llm_class: type, 
                        model: str, 
                        api_key: Optional[str], 
                        temperature: float, 
                        max_tokens: int) -> Any:
        """Instantiate LLM based on provider with clean parameters"""
        try:
            if provider == 'openai':
                return llm_class(
                    model=model,
                    api_key=api_key,
                    temperature=temperature,
                    max_tokens=max_tokens
                )
            elif provider == 'anthropic':
                return llm_class(
                    model=model,
