    last_seen: Optional[datetime] = None
    skills: List[str] = field(default_factory=list)
    timezone: str = "UTC"
    
    def to_dict(self) -> Dict[str, Any]:
        data = asdict(self)
        if self.last_seen:
            data['last_seen'] = self.last_seen.isoformat()
        return data

@dataclass
class Task:
    """Task/todo item"""
    task_id: str
    workspace_id: str
    title: str
    description: str
