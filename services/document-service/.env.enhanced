# Enhanced Document Processing Workflow Configuration

# Main workflow toggle - set to "false" to use traditional workflow
USE_ENHANCED_WORKFLOW=true

# Service integration toggles (only used when USE_ENHANCED_WORKFLOW=true)
ENABLE_VECTOR_INTEGRATION=true
ENABLE_GRAPH_INTEGRATION=true
ENABLE_WEBSOCKET_NOTIFICATIONS=true

# Service URLs for integration
VECTOR_SERVICE_URL=http://localhost:8005
GRAPH_SERVICE_URL=http://localhost:8006
WEBSOCKET_SERVICE_URL=http://localhost:8009
STORAGE_SERVICE_URL=http://localhost:8010

# Authentication token for service-to-service communication
SERVICE_AUTH_TOKEN=service-backend-token

# Processing options
DEBUG_DOCUMENT_CONVERSION_LOGS=false
