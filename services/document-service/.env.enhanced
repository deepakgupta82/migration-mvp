# Enhanced Document Processing Workflow Configuration

# Main workflow toggle - set to "false" to use traditional workflow
USE_ENHANCED_WORKFLOW=true

# Service integration toggles (only used when USE_ENHANCED_WORKFLOW=true)
ENABLE_VECTOR_INTEGRATION=true
ENABLE_GRAPH_INTEGRATION=true
ENABLE_WEBSOCKET_NOTIFICATIONS=true

# Service URLs for integration
VECTOR_SERVICE_URL=http://localhost:8005
GRAPH_SERVICE_URL=http://localhost:8006
WEBSOCKET_SERVICE_URL=http://localhost:8009
STORAGE_SERVICE_URL=http://localhost:8010

# Authentication token for service-to-service communication
SERVICE_AUTH_TOKEN=service-backend-token

# Processing options
DEBUG_DOCUMENT_CONVERSION_LOGS=false

# --- Enhanced Graph/LLM Tunables (safe defaults) ---
# Timeouts and retries for graph-service calls
GRAPH_MAX_RETRIES=3
GRAPH_BASE_TIMEOUT_SECONDS=900
GRAPH_MAX_TIMEOUT_SECONDS=900

# Input budgeting caps (characters)
GRAPH_NARRATIVE_CAP_CHARS=28000
GRAPH_SPREADSHEET_CAP_CHARS=20000

# Table trimming and batching for spreadsheets
GRAPH_TABLE_CONTENT_MAX_CHARS=10000
TABLE_GRAPH_BATCH_CHARS=12000
TABLE_GRAPH_MAX_ELEMENTS=450
GRAPH_MAX_ELEMENTS=0

# Section enrichment
SECTION_ENRICHMENT_ENABLED=true
SECTION_TOKEN_BUDGET=900

# Parallelism controls
ENABLE_PARALLEL_PROCESSING=true
MAX_CONCURRENT_INTEGRATIONS=2

# Websocket dedup window (seconds)
WEBSOCKET_DEDUP_WINDOW_SECONDS=1.5
