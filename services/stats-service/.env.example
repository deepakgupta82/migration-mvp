# Environment variables for stats service
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Service configuration
SERVICE_NAME=stats-service
SERVICE_PORT=8004
LOG_LEVEL=INFO

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# External service URLs
PROJECT_SERVICE_URL=http://localhost:8002
BACKEND_SERVICE_URL=http://localhost:8000
DOCUMENT_SERVICE_URL=http://localhost:8003
VECTOR_SERVICE_URL=http://localhost:8005
GRAPH_SERVICE_URL=http://localhost:8006

# Redis channel prefixes
REDIS_CHANNEL_PREFIX=migration_platform

# Cache settings
CACHE_TTL=3600
STATS_UPDATE_INTERVAL=10
